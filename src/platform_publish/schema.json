{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brustt/platform-publish/schema.json",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "eventSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "object",
      "required": [
        "value",
        "color",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "integer"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "transparent": {
          "type": "boolean"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "slug",
        "title",
        "description",
        "licence",
        "attribution"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "licence": {
          "$ref": "#/$defs/text"
        },
        "licence_url": {
          "type": "string"
        },
        "attribution": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "event",
        "title",
        "start",
        "end",
        "layers"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/eventSlug"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "compare": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "slug",
              "file",
              "role",
              "kind",
              "title",
              "categories"
            ],
            "additionalProperties": false,
            "properties": {
              "slug": {
                "$ref": "#/$defs/slug"
              },
              "file": {
                "$ref": "#/$defs/text"
              },
              "role": {
                "enum": [
                  "result",
                  "imagery",
                  "auxiliary"
                ]
              },
              "kind": {
                "enum": [
                  "raster"
                ]
              },
              "title": {
                "$ref": "#/$defs/text"
              },
              "shown": {
                "type": "boolean"
              },
              "acquired": {
                "type": "string"
              },
              "categories": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/category"
                }
              },
              "attribution": {
                "$ref": "#/$defs/text"
              },
              "licence": {
                "$ref": "#/$defs/text"
              },
              "licence_url": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "nodata": {
                "type": "number"
              },
              "crs": {
                "type": "string"
              },
              "bbox": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "media_type": {
                "type": "string"
              },
              "checksum": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}